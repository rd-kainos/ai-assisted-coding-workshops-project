{
  "name": "kainos-task-list-workshop",
  "private": true,
  "version": "1.0.0",
  "description": "Chrome extension workshop with TDD baseline",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "coverage": "c8 --all --include=todo-core.js --reporter=text --reporter=html --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 node --test tests/**/*.test.js",
    "ci:test": "npm run coverage"
  },
  "devDependencies": {
    "c8": "^10.1.2"
  }
}
